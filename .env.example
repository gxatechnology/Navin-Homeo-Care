# ========================================================================
# NAVIN HOMEO CARE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or set in Vercel Project Settings
# ========================================================================

# 1. APPLICATION & SERVER
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# 2. ADMINISTRATOR AUTHENTICATION
# Primary clinic administrator email address
ADMIN_EMAIL=navin@navinhomeocare.com
# Strong secret key used for HMAC-SHA256 signing of admin session tokens
ADMIN_SESSION_SECRET=nhc_secure_prod_session_secret_2026_change_me
# Administrator password configuration
ADMIN_INITIAL_PASSWORD=Navin123@$
ADMIN_PASSWORD_HASH=
ADMIN_API_KEY=

# 3. PRODUCTION DATABASE (PostgreSQL / Supabase / Neon / AWS RDS)
# In production (NODE_ENV=production), DATABASE_URL is REQUIRED.
# Format: postgresql://username:password@hostname:port/database_name?sslmode=require
DATABASE_URL=

# 4. SUPABASE CONFIGURATION (Optional alternative / storage backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
STORAGE_BUCKET=navin-homeo-care-assets

# 5. IMAGE & ASSET CLOUD STORAGE PROVIDERS (Production object storage)
# Options: cloudinary | supabase | s3 | local
STORAGE_PROVIDER=cloudinary

# Cloudinary Configuration (Recommended for product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# AWS S3 / Cloudflare R2 / MinIO (if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=navin-homeo-care-assets
